{
  "expo": {
    "name": "Goals",
    "slug": "goals",
    "scheme": "com.goals.app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3F3EE"
    },
    "ios": {
      "icon": "./assets/icon.png",
      "buildNumber": "53",
      "supportsTablet": false,
      "bundleIdentifier": "com.vibetime.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Goals uses your location to automatically track sessions at your physical goal locations.",
        "NSLocationWhenInUseUsageDescription": "Goals uses your location to set up geofences for your physical goals.",
        "NSLocationAlwaysUsageDescription": "Goals needs background location access to automatically detect when you arrive at your goal locations.",
        "UIBackgroundModes": [
          "location",
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.goals.app",
      "adaptiveIcon": {
        "backgroundColor": "#E0E5EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.vibetime.app.ExpoWidgetsTarget",
          "groupIdentifier": "group.com.vibetime.app",
          "enablePushNotifications": false,
          "frequentUpdates": false,
          "widgets": []
        }
      ],
      "./plugins/withGoalsNativeConfig",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F3EE",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Goals uses your location to automatically track sessions at your goal locations.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      "expo-task-manager",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-asset",
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "6c1a7200-3395-47a8-90fd-83c6a9acc486"
      }
    }
  }
}
