# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo
.domain-test-dist/

# generated native folders
/ios
/android
ornith-tests/

# Supabase local state and signing secrets
/supabase/.temp/
/supabase/apple-client-secret.jwt

# Blender-Renders (Rohdaten)
island/blender/out/

# Python bytecode (island/blender pipeline)
__pycache__/
*.pyc

# Local scratch and tool state, never part of the app
/tmp/
/.superpowers/
/.claude/worktrees/
