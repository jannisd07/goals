EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Set to `supabase` after deploying the authenticated `place-search` Edge
# Function and its migration. Alternatively use another HTTPS provider URL
# returning a Nominatim-compatible JSON array. Blank keeps the development
# fallback so a partially deployed backend cannot break place setup.
EXPO_PUBLIC_PLACE_SEARCH_ENDPOINT=
